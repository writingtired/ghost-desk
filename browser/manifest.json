{
  "manifest_version": 3,
  "name": "Ghost Desk • AI tabs",
  "version": "0.1.0",
  "description": "Report chat titles and visible activity to Ghost Desk on this PC and focus a selected tab.",
  "key": "",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "observe.js"
      ]
    }
  ]
}
